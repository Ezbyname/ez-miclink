<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BluetoothMicrophoneApp.Components.NeonVerticalSlider"
             x:Name="RootControl">

    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
        <!-- Value Label -->
        <Label x:Name="ValueLabel"
               Text="0"
               FontSize="18"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Slider Container -->
        <Grid WidthRequest="72" HeightRequest="180">

            <!-- Background Track -->
            <Border WidthRequest="14"
                    HeightRequest="180"
                    BackgroundColor="#00000099"
                    Stroke="#FFFFFF14"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
            </Border>

            <!-- Neon Fill (grows from bottom) -->
            <Border x:Name="FillBorder"
                    WidthRequest="14"
                    HeightRequest="0"
                    VerticalOptions="End"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
            </Border>

            <!-- Handle button: VerticalOptions=End, pushed up via Margin.Bottom (same as fill) -->
            <Border x:Name="HandleButton"
                    InputTransparent="True"
                    WidthRequest="48"
                    HeightRequest="24"
                    Stroke="#FFFFFF30"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    VerticalOptions="End">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2A3A" Offset="0.0" />
                        <GradientStop Color="#1B1B2A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border x:Name="InnerHighlight"
                        WidthRequest="20"
                        HeightRequest="4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="2" />
                    </Border.StrokeShape>
                </Border>
            </Border>

            <!-- Center/zero bold line -->
            <BoxView x:Name="CenterLine"
                     Color="#FFFFFFAA"
                     HeightRequest="2"
                     WidthRequest="40"
                     HorizontalOptions="Center"
                     VerticalOptions="Center" />

            <!-- Left Ticks -->
            <VerticalStackLayout Spacing="14" Margin="2,8,0,8"
                                 HorizontalOptions="Start" VerticalOptions="Fill">
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="End" />
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="End" />
            </VerticalStackLayout>

            <!-- Right Ticks -->
            <VerticalStackLayout Spacing="14" Margin="0,8,2,8"
                                 HorizontalOptions="End" VerticalOptions="Fill">
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF26" HeightRequest="2" WidthRequest="7" HorizontalOptions="Start" />
                <BoxView Color="#FFFFFF40" HeightRequest="2" WidthRequest="12" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <!-- Scale labels (set dynamically in code based on Min/Max) -->
            <Label x:Name="TopLabel" Text="10" FontSize="9" FontAttributes="Bold"
                   TextColor="#FFFFFF70"
                   HorizontalOptions="End" VerticalOptions="Start"
                   Margin="0,0,0,0" />
            <Label x:Name="MidLabel" Text="0" FontSize="9" FontAttributes="Bold"
                   TextColor="#FFFFFFAA"
                   HorizontalOptions="End" VerticalOptions="Center" />
            <Label x:Name="BottomLabel" Text="-10" FontSize="9" FontAttributes="Bold"
                   TextColor="#FFFFFF70"
                   HorizontalOptions="End" VerticalOptions="End"
                   Margin="0,0,0,0" />

            <!-- Touch overlay (must be last) -->
            <Grid x:Name="TouchOverlay"
                  BackgroundColor="Transparent"
                  InputTransparent="False"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />

        </Grid>

        <!-- Parameter Name -->
        <Label x:Name="ParameterLabel"
               FontSize="12"
               TextColor="#FFFFFF90"
               HorizontalOptions="Center"
               Margin="0,4,0,0" />
    </VerticalStackLayout>

</ContentView>
