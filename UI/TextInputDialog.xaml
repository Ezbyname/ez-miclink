<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BluetoothMicrophoneApp.UI.TextInputDialog"
             x:Name="DialogRoot"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             InputTransparent="False">

    <!-- Full Screen Overlay - Dark backdrop -->
    <Grid x:Name="OverlayGrid"
          BackgroundColor="#FF000000"
          IsVisible="False"
          InputTransparent="False">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <!-- ScrollView for keyboard avoidance -->
        <ScrollView VerticalOptions="Center">
            <!-- Dialog Container - Neon-Space glass card with neon gradient border -->
            <Border x:Name="DialogBorder"
                    Margin="24,40"
                    Padding="0"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="400"
                    Opacity="0"
                    Scale="0.9"
                    InputTransparent="False">

                <Border.Background>
                    <SolidColorBrush Color="#1A1A2E" />
            </Border.Background>

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00D2FF" Offset="0.0" />
                    <GradientStop Color="#8B5CF6" Offset="0.5" />
                    <GradientStop Color="#FF00FF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            <Border.StrokeThickness>1</Border.StrokeThickness>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#00D2FF"
                        Offset="0,8"
                        Radius="24"
                        Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Header - Neon-Space styling -->
                <Grid BackgroundColor="#1A000000"
                      Padding="24,24,24,16"
                      ColumnDefinitions="60,*"
                      ColumnSpacing="16">

                    <!-- Icon Badge - Neon-Space -->
                    <Border Grid.Column="0"
                            StrokeThickness="1"
                            WidthRequest="50"
                            HeightRequest="50"
                            VerticalOptions="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#1A00D2FF" />
                        </Border.Background>
                        <Border.Stroke>
                            <SolidColorBrush Color="#00D2FF" />
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#00D2FF"
                                    Offset="0,4"
                                    Radius="16"
                                    Opacity="0.6" />
                        </Border.Shadow>

                        <Label x:Name="IconLabel"
                               Text="✏️"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Title - Neon-Space typography -->
                    <Label Grid.Column="1"
                           x:Name="TitleLabel"
                           Text="Input"
                           TextColor="White"
                           FontFamily="Inter"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Content - Neon-Space typography -->
                <VerticalStackLayout Padding="24,20" Spacing="20">

                    <!-- Message -->
                    <Label x:Name="MessageLabel"
                           Text="Enter text:"
                           TextColor="White"
                           Opacity="0.8"
                           FontFamily="Inter"
                           FontSize="15"
                           LineHeight="1.4" />

                    <!-- Text Input Field - Neon-Space styling -->
                    <Border StrokeThickness="1"
                            BackgroundColor="#33000000"
                            Padding="16,12">
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D2FF" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry x:Name="InputEntry"
                               TextColor="White"
                               PlaceholderColor="#4D00D2FF"
                               FontFamily="Inter"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               Completed="OnInputCompleted" />
                    </Border>

                </VerticalStackLayout>

                <!-- Buttons - Neon-Space button styling -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="16"
                      Padding="24"
                      BackgroundColor="#1A000000">

                    <!-- Cancel Button - Glass with neon border -->
                    <Border Grid.Column="0"
                            StrokeThickness="1"
                            Stroke="#00D2FF"
                            BackgroundColor="Transparent"
                            HeightRequest="52"
                            InputTransparent="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Button x:Name="CancelButton"
                                Text="Cancel"
                                Clicked="OnCancelButtonClicked"
                                BackgroundColor="Transparent"
                                TextColor="#00D2FF"
                                FontFamily="Inter"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                    </Border>

                    <!-- OK Button - Neon gradient -->
                    <Border Grid.Column="1"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            HeightRequest="52"
                            InputTransparent="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D2FF" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#00D2FF"
                                    Offset="0,8"
                                    Radius="20"
                                    Opacity="0.4" />
                        </Border.Shadow>

                        <Button x:Name="OkButton"
                                Text="OK"
                                Clicked="OnOkButtonClicked"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontFamily="Inter"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </Border>
        </ScrollView>

    </Grid>
</ContentView>
