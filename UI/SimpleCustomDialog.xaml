<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BluetoothMicrophoneApp.UI.SimpleCustomDialog"
             x:Name="DialogRoot"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             InputTransparent="False">

    <!-- Full Screen Overlay - Dark backdrop -->
    <Grid x:Name="OverlayGrid"
          BackgroundColor="#FF000000"
          IsVisible="False"
          InputTransparent="False">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <!-- Dialog Container - Neon-Space glass card with neon gradient border -->
        <Border x:Name="DialogBorder"
                Margin="24,0"
                Padding="0"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                MaximumWidthRequest="400"
                Opacity="0"
                Scale="0.9"
                InputTransparent="False">

            <Border.Background>
                <SolidColorBrush Color="#1A1A2E" />
            </Border.Background>

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00D2FF" Offset="0.0" />
                    <GradientStop Color="#8B5CF6" Offset="0.5" />
                    <GradientStop Color="#FF00FF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            <Border.StrokeThickness>1</Border.StrokeThickness>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="#00D2FF"
                        Offset="0,8"
                        Radius="24"
                        Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Header - Neon-Space styling -->
                <Grid BackgroundColor="#1A000000"
                      Padding="24,24,24,16"
                      ColumnDefinitions="60,*"
                      ColumnSpacing="16">

                    <!-- Icon Badge - Neon-Space -->
                    <Border Grid.Column="0"
                            StrokeThickness="1"
                            WidthRequest="50"
                            HeightRequest="50"
                            VerticalOptions="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#1A00D2FF" />
                        </Border.Background>
                        <Border.Stroke>
                            <SolidColorBrush Color="#00D2FF" />
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#00D2FF"
                                    Offset="0,4"
                                    Radius="16"
                                    Opacity="0.6" />
                        </Border.Shadow>

                        <Label x:Name="IconLabel"
                               Text="ℹ️"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Title - Neon-Space typography -->
                    <Label Grid.Column="1"
                           x:Name="TitleLabel"
                           Text="Dialog Title"
                           TextColor="White"
                           FontFamily="Inter"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Content - Neon-Space typography -->
                <ScrollView MaximumHeightRequest="400">
                    <VerticalStackLayout Padding="24,16" Spacing="16">

                        <!-- Message -->
                        <Label x:Name="MessageLabel"
                               Text="Dialog message"
                               TextColor="White"
                               Opacity="0.8"
                               FontFamily="Inter"
                               FontSize="15"
                               LineHeight="1.4"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <!-- Bullet Points -->
                        <VerticalStackLayout x:Name="BulletPointsContainer"
                                           Spacing="8"
                                           IsVisible="False" />

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Buttons - Neon-Space button styling -->
                <Grid x:Name="ButtonContainer"
                      ColumnDefinitions="*"
                      ColumnSpacing="16"
                      Padding="24"
                      BackgroundColor="#1A000000">

                    <!-- Primary Button - Neon gradient -->
                    <Border Grid.Column="0"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            HeightRequest="52"
                            InputTransparent="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D2FF" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#00D2FF"
                                    Offset="0,8"
                                    Radius="20"
                                    Opacity="0.4" />
                        </Border.Shadow>

                        <Button x:Name="PrimaryButton"
                                Text="OK"
                                Clicked="OnPrimaryButtonClicked"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontFamily="Inter"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                    </Border>

                    <!-- Secondary Button - Glass with neon border -->
                    <Border x:Name="SecondaryButtonBorder"
                            Grid.Column="1"
                            StrokeThickness="1"
                            Stroke="#00D2FF"
                            BackgroundColor="Transparent"
                            HeightRequest="52"
                            IsVisible="False"
                            InputTransparent="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Button x:Name="SecondaryButton"
                                Text="Cancel"
                                Clicked="OnSecondaryButtonClicked"
                                BackgroundColor="Transparent"
                                TextColor="#00D2FF"
                                FontFamily="Inter"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentView>
